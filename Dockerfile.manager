FROM oven/bun:1 AS page

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY page ./page
RUN bun run build:page

FROM node:24.15.0-alpine

WORKDIR /app

COPY source ./source
COPY Dockerfile.desktop ./Dockerfile.desktop
COPY --from=page /app/dist ./dist

ENV NODE_ENV=production \
    DEMO_LISTEN_HOST=0.0.0.0 \
    DEMO_LISTEN_PORT=8080 \
    DEMO_ENTRY_HOST=demo.phreshos.com \
    DEMO_SESSION_DOMAIN=phreshos.com \
    DEMO_DOCKER_SOCKET=/var/run/docker.sock \
    DEMO_DOCKER_NETWORK=phresh-demo \
    DEMO_IMAGE_REPOSITORY=phreshos/demo \
    DEMO_IMAGE_CHECK_MILLISECONDS=1800000 \
    DEMO_STATE=/data/sessions.json \
    DEMO_LIFETIME_MILLISECONDS=3600000 \
    DEMO_IDLE_MILLISECONDS=600000 \
    DEMO_MAX_SESSIONS=20

EXPOSE 8080

HEALTHCHECK --interval=5s --timeout=2s --start-period=5s --retries=5 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:8080/__manager/health').then(response => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"]

CMD ["node", "source/server.mjs"]
